# LF everywhere: goldens, scripts and embedded text compare byte-for-byte on every OS,
# including Windows runners that check out with core.autocrlf=true.
* text=auto eol=lf

*.png binary
*.gif binary
*.jpg binary

# The docs site's third-party scripts, styles and licences, byte for byte as their npm packages
# publish them (some with CRLF line ends), so they can be checked against the packages' hashes.
site/assets/vendor/** -text linguist-vendored
